# IronCore — Build Configuration Template
# Скопируйте этот файл в .env и заполните под свою машину.
# Никогда не коммитьте .env в репозиторий.

# ── Версии ────────────────────────────────────────────────────────────────────
MC_VERSION=1.20.1
FORGE_VERSION=47.2.0
GECKOLIB_VERSION=4.4.9
MOD_VERSION=1.0

# ── Деплой (необязательно) ────────────────────────────────────────────────────
# Путь к папке mods вашего клиента Minecraft для ручного копирования артефакта.
# Используется вспомогательным скриптом deploy.sh, не частью основной сборки.
MC_MODS_PATH=~/.minecraft/mods

# ── Сборка ────────────────────────────────────────────────────────────────────
# Дополнительные JVM-флаги для Gradle-daemon (увеличьте heap при нехватке RAM).
GRADLE_OPTS=-Xmx3G -XX:+UseG1GC
