<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  IronCore — Checkstyle configuration
  Профиль: минимальный, ориентированный на реальные дефекты кода.
  Запуск: ./gradlew checkstyleMain
-->
<module name="Checker">
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- Файлы не должны содержать символы табуляции -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="false"/>
    </module>

    <module name="TreeWalker">

        <!-- ── Импорты ─────────────────────────────────────────────────── -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="IllegalImport">
            <!-- Запрет sun.* API — непортируемые внутренние классы JDK -->
            <property name="illegalPkgs" value="sun"/>
        </module>

        <!-- ── Пустые блоки ───────────────────────────────────────────── -->
        <module name="EmptyStatement"/>
        <module name="EmptyCatchBlock">
            <!-- Разрешены только блоки с комментарием или именем "ignored"/"expected" -->
            <property name="exceptionVariableName" value="expected|ignored|ignore"/>
        </module>

        <!-- ── Простейшие дефекты ─────────────────────────────────────── -->
        <!-- Нельзя напрямую сравнивать строки через == -->
        <module name="StringLiteralEquality"/>
        <!-- Лишние скобки вокруг return -->
        <module name="UnnecessaryParentheses"/>
        <!-- Дублирующиеся модификаторы (public public) -->
        <module name="ModifierOrder"/>

        <!-- ── Именование (мягкий вариант) ───────────────────────────── -->
        <module name="ConstantName">
            <!-- SCREAMING_SNAKE_CASE для static final, с префиксом-артефактом GeckoLib допустим -->
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

    </module>
</module>
